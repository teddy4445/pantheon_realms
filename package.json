{
  "name": "pantheon-realms",
  "private": true,
  "version": "0.14.0",
  "description": "Pantheon Realms — turn-based mythological strategy (TypeScript rules, React UI, PixiJS 2D, Electron).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @pr/client run dev",
    "build": "npm --workspace @pr/client run build",
    "preview": "npm --workspace @pr/client run preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p apps/client/tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "lint:boundaries": "node tools/check-boundaries.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:build": "npm --workspace @pr/desktop run build",
    "desktop": "npm run build && npm run desktop:build && npm --workspace @pr/desktop run start",
    "desktop:dist": "npm run build && npm run desktop:build && npm --workspace @pr/desktop run dist",
    "check": "npm run lint:boundaries && npm run typecheck && npm test",
    "balance": "node tools/balance/run.mjs",
    "campaign-sim": "node tools/campaign-sim/run.mjs",
    "icons:catalog": "vitest run --config tools/assets/icon-catalog/vitest.config.ts && node tools/assets/icon-catalog/render-glyphs.mjs && python3 tools/assets/icon-catalog/build_icon_catalog.py",
    "icons:import": "python3 tools/assets/icon-catalog/import_icons.py",
    "cursors:import": "python3 tools/assets/import_cursors.py",
    "art:import": "python3 tools/assets/import_story_art.py",
    "sprites:plan": "vitest run --config tools/assets/sprites/vitest.config.ts",
    "vfx:list": "vitest run --config tools/assets/vfx/vitest.config.ts",
    "art:briefs": "vitest run --config tools/assets/briefs/vitest.config.ts tools/assets/briefs/art-briefs.measure.ts",
    "art:brief12": "vitest run --config tools/assets/briefs/vitest.config.ts tools/assets/briefs/brief12.measure.ts && python3 tools/assets/briefs/town_guides.py",
    "sprites:cut": "python3 tools/assets/sprites/cut_sheets.py",
    "sprites:import": "python3 tools/assets/sprites/import_sprites.py",
    "sprites:queue": "python3 tools/assets/sprites/build_gpt6_queue.py",
    "maps:build": "vitest run --config tools/maps/vitest.config.ts tools/maps/build.author.ts && python3 tools/maps/layout_guides.py",
    "art:siege-guide": "python3 tools/assets/briefs/siege_guide.py",
    "art:road-guides": "python3 tools/assets/briefs/road_guides.py",
    "roads:import": "python3 tools/assets/roads/import_roads.py",
    "art:ground-guides": "python3 tools/assets/briefs/ground_guides.py",
    "ground:import": "python3 tools/assets/ground/import_ground.py"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
